# videoprodutos — tudo opcional; sem este arquivo roda com defaults locais e gratuitos
PORT=3080
OUTPUT_DIR=/home/eu/projetos/output/videoprodutos
BRAND=
CTA=Garanta o seu

# LLM (copy/classificação): none | ollama | openai
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.8:27b
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Imagem por IA (preset "cenario-ia"): none | inemaimg | agnes | openai
IMG_PROVIDER=inemaimg
INEMAIMG_URL=http://127.0.0.1:8000
INEMAIMG_MODEL=flux2-klein
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_API_KEY=
AGNES_MODEL=agnes-image-2.1-flash
IMG_BASE_URL=https://api.openai.com/v1
IMG_API_KEY=
IMG_MODEL=gpt-image-1

# Áudio (inemavox local)
INEMAVOX_URL=http://127.0.0.1:8010
TTS_ENGINE=edge
TTS_VOICE=pt-BR-FranciscaNeural
MUSIC=freesound

# Render
ENCODER=auto
PYTHON=./.venv/bin/python
