# videoprodutos — perfil VPS (sem GPU, sem serviços locais): Agnes para copy, cenário e vídeo; edge-tts direto; música sintética ou Freesound API
PORT=3080
OUTPUT_DIR=/root/projetos/output/videoprodutos
APP_PASSWORD=troque-esta-senha
BRAND=
CTA=Garanta o seu

LLM_PROVIDER=agnes
AGNES_TEXT_MODEL=agnes-2.0-flash

IMG_PROVIDER=agnes
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_API_KEY=
AGNES_MODEL=agnes-image-2.1-flash

VIDEO_ENGINE=agnes
AGNES_VIDEO_MODEL=agnes-video-v2.0
AI_SCENES=2

TTS_ENGINE=edge-local
TTS_VOICE=pt-BR-FranciscaNeural
MUSIC=synth
FREESOUND_API_KEY=

ENCODER=libx264
PYTHON=/root/projetos/videoprodutos/.venv/bin/python
